# JSON service account Google (akses baca ke spreadsheet).
# Gunakan tanda kutip tunggal agar JSON multi-baris terbaca oleh dotenv.
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# ID spreadsheet (bagian URL di antara /d/ dan /edit)
GOOGLE_SHEET_ID="ISI_ID_SPREADSHEET"

# Opsional: nama tab kalau berbeda dari bawaan
# SHEET_AIRLINE="CSS Airline Tally"

# Login dashboard: satu password admin + rahasia penanda tangan cookie (minimal 32 karakter acak).
# Mengganti salah satunya langsung mengeluarkan semua sesi yang aktif.
DASHBOARD_PASSWORD="ISI_PASSWORD_PANJANG"
AUTH_SECRET="ISI_STRING_ACAK_MINIMAL_32_KARAKTER"

# Penyimpanan link bagikan (Upstash Redis lewat Vercel Marketplace; Vercel menamainya KV_REST_API_URL/TOKEN, keduanya didukung).
# Wajib di produksi. Tanpa ini di Vercel, link tidak bisa dibuat. Lokal memakai berkas .data/ otomatis.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="ISI_TOKEN"

# ── Menu Tindak Lanjut (tracking follow up feedback) ──
# ID sheet "Tracking Follow Up Index CSS Airline" (bagian URL di antara /d/ dan /edit). Service account WAJIB berstatus Editor di sheet ini
# (sheet survei di atas tetap hanya-baca). Tab bawaan: B2C dan Rekap; ganti lewat TRACKER_TAB dan TRACKER_TAB_REKAP bila perlu (mis. uji pada salinan).
TRACKER_SHEET_ID=
# Tiga tingkat password menu; ketiganya harus berbeda satu sama lain dan dari DASHBOARD_PASSWORD.
# admin = penuh | manager (Management) = boleh mengisi dan mengubah | viewer = hanya melihat. Mengganti salah satunya mengeluarkan semua sesi menu.
FOLLOWUP_ADMIN_PASSWORD=
FOLLOWUP_MANAGER_PASSWORD=
FOLLOWUP_VIEWER_PASSWORD=
# Token webhook Apps Script (integrations/apps-script-webhook.gs), minimal 24 karakter acak. Kosong = webhook mati (sinkronisasi tetap jalan saat menu dibuka).
FOLLOWUP_SYNC_TOKEN=
# Unggah evidence ke Google Drive lewat Apps Script (integrations/apps-script-evidence-upload.gs). Kosong = fitur Upload Evidence belum aktif.
EVIDENCE_UPLOAD_URL=
EVIDENCE_UPLOAD_TOKEN=
# Opsional: 1 = matikan sinkronisasi survei ke sheet tracker (uji baca-saja).
# TRACKER_SYNC_DISABLED=1
