# JSON service account Google (akses baca ke spreadsheet).
# Gunakan tanda kutip tunggal agar JSON multi-baris terbaca oleh dotenv.
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# ID spreadsheet (bagian URL di antara /d/ dan /edit)
GOOGLE_SHEET_ID="..."

# Opsional: nama sheet kalau berbeda dari bawaan
# SHEET_B2C="B2C CSS Tally"
# SHEET_B2B="B2B CSS Tally"
