# JSON service account Google (akses baca ke spreadsheet).
# Gunakan tanda kutip tunggal agar JSON multi-baris terbaca oleh dotenv.
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# ID spreadsheet (bagian URL di antara /d/ dan /edit)
GOOGLE_SHEET_ID="ISI_ID_SPREADSHEET"

# Opsional: nama tab kalau berbeda dari bawaan
# SHEET_AIRLINE="CSS Airline Tally"

# Login dashboard: satu password admin + rahasia penanda tangan cookie (minimal 32 karakter acak).
# Mengganti salah satunya langsung mengeluarkan semua sesi yang aktif.
DASHBOARD_PASSWORD="ISI_PASSWORD_PANJANG"
AUTH_SECRET="ISI_STRING_ACAK_MINIMAL_32_KARAKTER"

# Penyimpanan link bagikan (Upstash Redis lewat Vercel Marketplace; Vercel menamainya KV_REST_API_URL/TOKEN, keduanya didukung).
# Wajib di produksi. Tanpa ini di Vercel, link tidak bisa dibuat. Lokal memakai berkas .data/ otomatis.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="ISI_TOKEN"
